# Copy to .env and fill in your values

# Database (same as the Next.js app)
DATABASE_URL="postgresql://user:password@host:5432/losmuento"

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN="your-bot-token-here"

# Discord Guild (server) ID — right-click your server > Copy Server ID
DISCORD_GUILD_ID="your-guild-id-here"

# Channel IDs — right-click a channel > Copy Channel ID
DISCORD_ANNOUNCEMENTS_CHANNEL="channel-id-for-announcements"
DISCORD_EVENTS_CHANNEL="channel-id-for-events"
DISCORD_RANKINGS_CHANNEL="channel-id-for-rankings"
DISCORD_ALERTS_CHANNEL="channel-id-for-alerts"

# Varianta C — new notification channels
DISCORD_TASKS_CHANNEL="channel-id-for-tasks"
DISCORD_TERRITORIES_CHANNEL="channel-id-for-territories"
DISCORD_FAMILY_CHANNEL="channel-id-for-family"
