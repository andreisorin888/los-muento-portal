# Copy to .env.local. Placeholders only - never commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 1: show the demo-data banner and the "preview as" switcher.
# Set to "false" before production launch.
NEXT_PUBLIC_DEMO_DATA=true

# Phase 2+: PostgreSQL (docker-compose provides one locally)
DATABASE_URL=postgresql://losmuento:losmuento_dev@localhost:5432/losmuento

# Discord OAuth - create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
